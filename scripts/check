#!/usr/bin/env bash
#MISE description="Type-check and vet every owned package (no binaries produced)"
#MISE alias="c"
#USAGE arg "[package]" help="Package to check; omit for all"
#USAGE complete "package" run="bash -c 'source scripts/_lib.sh 2>/dev/null || source $(git rev-parse --show-toplevel 2>/dev/null)/scripts/_lib.sh 2>/dev/null && nabla_check_packages 2>/dev/null'"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
cd "$NABLA_ROOT"

# Flags mirror checker_args in ols.json.
flags=(-vet -strict-style -vet-tabs -disallow-do -warnings-as-errors -no-entry-point "-collection:nabla=$NABLA_ROOT")

target="${usage_package:-${1:-}}"
mapfile -t packages < <(nabla_check_packages)
[[ -n "$target" ]] && packages=("$target")

failed=()
for pkg in "${packages[@]}"; do
	nabla_step "check $pkg"
	odin check "./$pkg" "${flags[@]}" || failed+=("$pkg")
done
if ((${#failed[@]})); then
	nabla_die "check failed: ${failed[*]}"
fi
