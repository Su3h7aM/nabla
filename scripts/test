#!/usr/bin/env bash
#MISE description="Run every test: in-package suites, then the external harnesses"
#MISE alias="t"
#USAGE arg "[target]" help="Package or harness to test; omit for all"
#USAGE flag "--debug-only" help="Only run the -debug configuration"
#USAGE flag "--release-only" help="Only run the release configuration"
#USAGE flag "--sanitize <kind>" help="Odin sanitizer for odin test" {
#USAGE   choices "address" "memory" "thread"
#USAGE }
#USAGE complete "target" run="bash -c 'source scripts/_lib.sh 2>/dev/null || source $(git rev-parse --show-toplevel 2>/dev/null)/scripts/_lib.sh 2>/dev/null && { nabla_test_packages; for h in $(nabla_harnesses); do echo ${h##*/}; done; } 2>/dev/null'"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
cd "$NABLA_ROOT"

target="${usage_target:-}"
debug_only="${usage_debug_only:-false}"
release_only="${usage_release_only:-false}"
sanitize="${usage_sanitize:-}"
skip_next=false
for arg in "$@"; do
	if "$skip_next"; then
		sanitize="$arg"
		skip_next=false
		continue
	fi
	case "$arg" in
		--debug-only)   debug_only=true ;;
		--release-only) release_only=true ;;
		--sanitize)     skip_next=true ;;
		--sanitize=*)   sanitize="${arg#--sanitize=}" ;;
		-*)             nabla_die "unknown flag: $arg" ;;
		*)              target="$arg" ;;
	esac
done

timeout_secs=300
collection="-collection:nabla=$NABLA_ROOT"

configs=()
"$debug_only" || configs+=(release)
"$release_only" || configs+=(debug)

mapfile -t packages < <(nabla_test_packages)
mapfile -t harnesses < <(nabla_harnesses)

failed=()
for config in "${configs[@]}"; do
	for pkg in "${packages[@]}"; do
		[[ -n "$target" && "$target" != "$pkg" ]] && continue
		extra=()
		[[ $config == debug ]] && extra+=(-debug)
		[[ -n $sanitize ]] && extra+=("-sanitize:$sanitize")
		case " $NABLA_SERIAL_TEST_PACKAGES " in
			*" $pkg "*) extra+=(-define:ODIN_TEST_THREADS=1) ;;
		esac
		nabla_step "test $pkg ($config)"
		timeout --foreground "$timeout_secs" odin test "./$pkg" "$collection" "${extra[@]}" || failed+=("$pkg ($config)")
	done
done

for h in "${harnesses[@]}"; do
	[[ -n "$target" && "$target" != "$(basename "$h")" ]] && continue
	nabla_step "harness $h"
	timeout --foreground "$timeout_secs" odin run "./$h" "$collection" -define:NABLA_TERM_TEST_HOOKS=true || failed+=("$h")
done

if [[ -z $target ]]; then
	smoke_dir="$NABLA_ROOT/.scratch/smoke"
	mkdir -p "$smoke_dir"
	for app in demo examples/dashboard; do
		[[ -f "$NABLA_ROOT/$app/main.odin" ]] || continue
		out="$smoke_dir/$(basename "$app")"
		nabla_step "smoke $app"
		odin build "./$app" "$collection" -o:speed -out:"$out" || { failed+=("$app build"); continue; }
		script -qec "\"$out\"" /dev/null </dev/null >/dev/null 2>&1 || failed+=("$app smoke")
	done
	rm -rf "$smoke_dir"
fi

if ((${#failed[@]})); then
	nabla_die "test failed: ${failed[*]}"
fi
