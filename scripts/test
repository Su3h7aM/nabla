#!/usr/bin/env bash
#MISE description="Run every test suite"
#MISE alias="t"
#USAGE arg "[target]" help="Package to test; omit for all"
#USAGE flag "--debug-only" help="Only run the -debug configuration"
#USAGE flag "--release-only" help="Only run the release configuration"
#USAGE flag "--sanitize <kind>" help="Odin sanitizer for odin test" {
#USAGE   choices "address" "memory" "thread"
#USAGE }
#USAGE flag "--test <names>" help="Comma-separated test names (name or package.name) to run"
#USAGE flag "--log-state" help="Log each test state change, to find a stalled test"
#USAGE complete "target" run="bash -c 'source scripts/_lib.sh 2>/dev/null || source $(git rev-parse --show-toplevel 2>/dev/null)/scripts/_lib.sh 2>/dev/null && nabla_test_packages 2>/dev/null'"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
cd "$NABLA_ROOT"

# A direct run leaves the usage_* variables unset, so one loop parses the
# arguments for both mise and direct runs; the #USAGE lines only feed mise
# help and completion.
target=""
debug_only=false
release_only=false
sanitize=""
test_names=""
log_state=false
while (($#)); do
	case "$1" in
		--debug-only)   debug_only=true ;;
		--release-only) release_only=true ;;
		--log-state)    log_state=true ;;
		--sanitize)     (($# >= 2)) || nabla_die "--sanitize needs a value"; sanitize="$2"; shift ;;
		--sanitize=*)   sanitize="${1#--sanitize=}" ;;
		--test)         (($# >= 2)) || nabla_die "--test needs a value"; test_names="$2"; shift ;;
		--test=*)       test_names="${1#--test=}" ;;
		-*)             nabla_die "unknown flag: $1" ;;
		*)              target="$1" ;;
	esac
	shift
done

timeout_secs=300
collection="-collection:nabla=$NABLA_ROOT"

# Both configurations run: -debug carries extra contract asserts (notably in
# layout and tui) that release compiles out, while release tests the exact
# codegen that ships. One mode cannot stand in for the other.
configs=()
"$debug_only" || configs+=(release)
"$release_only" || configs+=(debug)

mapfile -t packages < <(nabla_test_packages)

failed=()
for config in "${configs[@]}"; do
	for pkg in "${packages[@]}"; do
		[[ -n "$target" && "$target" != "$pkg" ]] && continue
		extra=(
			-define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true
			"${NABLA_DEFINES[@]}"
		)
		[[ $config == debug ]] && extra+=(-debug)
		[[ -n $sanitize ]] && extra+=("-sanitize:$sanitize")
		[[ -n $test_names ]] && extra+=("-define:ODIN_TEST_NAMES=$test_names")
		"$log_state" && extra+=(-define:ODIN_TEST_LOG_STATE_CHANGES=true)
		# The PTY lifecycle test needs the term fault-injection hooks; without
		# the define its file contributes no tests.
		[[ "$pkg" == term ]] && extra+=(-define:NABLA_TERM_TEST_HOOKS=true)
		nabla_step "test $pkg ($config)"
		status=0
		nabla_contained timeout "$timeout_secs" odin test "$pkg" "$collection" "${extra[@]}" || status=$?
		if ((status)); then
			failed+=("$pkg ($config)")
			((status != 124)) || printf 'hint: %s timed out after %ss; rerun with --log-state and --test <names> to find the stalled test\n' "$pkg" "$timeout_secs" >&2
		fi
	done
done

if ((${#failed[@]})); then
	nabla_die "test failed: ${failed[*]}"
fi
