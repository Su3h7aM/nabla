#!/usr/bin/env bash
#MISE description="Build every library package as a shared object, and every executable"
#USAGE arg "[package]" help="Package to build; omit for all"
#USAGE complete "package" run="bash -c 'source scripts/_lib.sh 2>/dev/null || source $(git rev-parse --show-toplevel 2>/dev/null)/scripts/_lib.sh 2>/dev/null && nabla_check_packages 2>/dev/null'"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
cd "$NABLA_ROOT"

target="${usage_package:-${1:-}}"
out="$NABLA_ROOT/build"
mkdir -p "$out"
collection="-collection:nabla=$NABLA_ROOT"

mapfile -t packages < <(nabla_packages)
[[ -n "$target" ]] && packages=("$target")

failed=()
for pkg in "${packages[@]}"; do
	nabla_step "build $pkg"
	lib="${pkg//\//-}"
	odin build "./$pkg" -build-mode:shared "$collection" -out:"$out/lib$lib.so" || failed+=("$pkg")
done

mapfile -t executables < <(nabla_executables)
for bin in "${executables[@]}"; do
	[[ -n "$target" && "$target" != "$bin" ]] && continue
	nabla_step "build $bin"
	odin build "./$bin" "$collection" -out:"$out/$(basename "$bin")" || failed+=("$bin")
done
if ((${#failed[@]})); then
	nabla_die "build failed: ${failed[*]}"
fi
