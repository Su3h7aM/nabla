#!/usr/bin/env bash
#MISE description="Build the executable or one library package"
#USAGE arg "[package]" help="Library package to build; omit for the executable"
#USAGE flag "--release" help="Optimize with thin LTO"
#USAGE flag "--debug" help="Build with debug information"
#USAGE complete "package" run="bash -c 'source scripts/_lib.sh 2>/dev/null || source $(git rev-parse --show-toplevel 2>/dev/null)/scripts/_lib.sh 2>/dev/null && nabla_check_packages 2>/dev/null'"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
cd "$NABLA_ROOT"

target=""
mode=""
for arg in "$@"; do
	case "$arg" in
		--release|--debug)
			[[ -z "$mode" || "$mode" == "$arg" ]] || nabla_die "--release and --debug cannot be combined"
			mode="$arg" ;;
		-*) nabla_die "unknown flag: $arg" ;;
		*)  [[ -z "$target" ]] || nabla_die "only one package can be built at a time"; target="$arg" ;;
	esac
done
target="${target:-.}"
flags=()
case "$mode" in
	--release) flags=(-o:speed -lto:thin) ;;
	--debug)   flags=(-debug) ;;
esac
out="$NABLA_ROOT/build"
mkdir -p "$out"
collection="-collection:nabla=$NABLA_ROOT"

if [[ "$target" == "." ]]; then
	name="$(basename "$NABLA_ROOT")"
	nabla_step "build $name"
	"$NABLA_ODIN" build . "$collection" "${NABLA_DEFINES[@]}" "${flags[@]}" -out:"$out/$name"
else
	nabla_step "build $target"
	lib="${target//\//-}"
	"$NABLA_ODIN" build "$target" -build-mode:shared "$collection" "${NABLA_DEFINES[@]}" "${flags[@]}" -out:"$out/lib$lib.so"
fi
