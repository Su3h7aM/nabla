#!/usr/bin/env bash
#MISE description="Format owned Odin sources with odinfmt (odinfmt.json rules)"
#MISE alias="f"
#USAGE arg "[path]" help="File to format; omit for all owned sources"
#USAGE flag "--check" help="Report unformatted files and exit non-zero; write nothing"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
cd "$NABLA_ROOT"

target="${usage_path:-}"
check="${usage_check:-false}"
for arg in "$@"; do
	case "$arg" in
		--check) check=true ;;
		-*)      nabla_die "unknown flag: $arg" ;;
		*)       target="$arg" ;;
	esac
done

if [[ -n $target ]]; then
	sources=("$target")
else
	mapfile -t sources < <(nabla_owned_sources)
fi

if "$check"; then
	unformatted=()
	for f in "${sources[@]}"; do
		odinfmt "$f" | cmp -s - "$f" || unformatted+=("$f")
	done
	if ((${#unformatted[@]})); then
		printf 'unformatted:\n'
		printf '  %s\n' "${unformatted[@]}"
		nabla_die "${#unformatted[@]} file(s) need formatting"
	fi
else
	for f in "${sources[@]}"; do
		odinfmt -w "$f" >/dev/null
	done
fi
