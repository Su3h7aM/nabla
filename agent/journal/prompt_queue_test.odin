#+test
#+private file
package journal

import "core:os"
import "core:testing"
import "core:time"
import "nabla:ai"
import "nabla:db"

@(test)
test_prompt_queue_and_history :: proc(test: ^testing.T) {
	directory := _temp_directory(test)
	defer _remove_directory(directory)
	journal := _open_journal(test, directory)
	defer _close_journal(test, journal)
	session := _create_session(test, journal, {workspace = "/tmp/project", role = .Main})
	_commit_ok(test, journal)
	first, first_error := queue_push(journal, session, .Steering, "one", {"a\nb", "b"})
	_expect_ok(test, first_error)
	second, second_error := queue_push(journal, session, .Follow_Up, "two", nil)
	_expect_ok(test, second_error)
	found, edit_error := queue_edit(journal, session, first, "edited")
	_expect_ok(test, edit_error)
	testing.expect(test, found)
	entries, list_error := queue_list(journal, session, context.allocator)
	_expect_ok(test, list_error)
	defer queue_entries_destroy(entries, context.allocator)
	if testing.expect_value(test, len(entries), 2) {
		testing.expect_value(test, entries[0].text, "edited")
		testing.expect_value(test, entries[0].attachments[0], "a\nb")
		testing.expect_value(test, entries[1].id, second)
	}
	removed, remove_error := queue_remove(journal, session, second)
	_expect_ok(test, remove_error)
	testing.expect(test, removed)
	third, third_error := queue_push(journal, session, .Steering, "three", nil)
	_expect_ok(test, third_error)
	testing.expect(test, third > second)
	_expect_ok(test, history_append(journal, session, "first"))
	_expect_ok(test, history_append(journal, session, "second"))
	history, history_error := history_list(journal, session, context.allocator)
	_expect_ok(test, history_error)
	defer history_destroy(history, context.allocator)
	if testing.expect_value(test, len(history), 2) {
		testing.expect_value(test, history[0], "first")
		testing.expect_value(test, history[1], "second")
	}
}

@(test)
test_prompt_delivery_is_atomic :: proc(test: ^testing.T) {
	directory := _temp_directory(test)
	defer _remove_directory(directory)
	writer := _open_journal(test, directory)
	defer _close_journal(test, writer)
	holder := _open_journal(test, directory)
	defer _close_journal(test, holder)
	session := _create_session(test, writer, {workspace = "/tmp/project", role = .Main})
	_commit_ok(test, writer)
	id, push_error := queue_push(writer, session, .Steering, "before", {"image"})
	_expect_ok(test, push_error)
	attachment := ai.Provider_Attachment {
		Media = .PNG,
		Name  = "image",
		Data  = {1, 2, 3},
	}
	result: Queue_Delivery
	queue_deliver(writer, session, id, {attachment}, &result)
	found, edit_error := queue_edit(writer, session, id, "after")
	_expect_ok(test, edit_error)
	testing.expect(test, found)
	_expect_db_ok(test, db.exec(&writer.connection, "PRAGMA busy_timeout = 0"))
	_expect_db_ok(test, db.exec(&holder.connection, "BEGIN IMMEDIATE"))
	_, busy_error := commit(writer)
	testing.expect(test, error_is_busy(busy_error))
	testing.expect(test, !result.completed)
	entries, list_error := queue_list(writer, session, context.allocator)
	_expect_ok(test, list_error)
	testing.expect_value(test, len(entries), 1)
	queue_entries_destroy(entries, context.allocator)
	_expect_db_ok(test, db.rollback(&holder.connection))
	_commit_ok(test, writer)
	testing.expect(test, result.completed && result.seq != 0)
	found_after, edit_after_error := queue_edit(writer, session, id, "too late")
	_expect_ok(test, edit_after_error)
	testing.expect(test, !found_after)
	records := _records_of_session(test, writer, session)
	defer records_destroy(records, context.allocator)
	count := 0
	for record in records {
		if record.kind == .User_Input {
			count += 1
			testing.expect_value(test, record.seq, result.seq)
			testing.expect_value(test, string(record.body), "after")
		}
	}
	testing.expect_value(test, count, 1)
	attachment_count, query_error := query_int(writer, "SELECT COUNT(*) FROM record_attachment WHERE seq = ?", {db.Value(i64(result.seq))})
	_expect_ok(test, query_error)
	testing.expect_value(test, attachment_count, i64(1))
	origin, origin_error := query_int(writer, "SELECT origin FROM record_user_input WHERE seq = ?", {db.Value(i64(result.seq))})
	_expect_ok(test, origin_error)
	testing.expect_value(test, origin, i64(User_Origin.Steering))
	missing: Queue_Delivery
	queue_deliver(writer, session, id, nil, &missing)
	_commit_ok(test, writer)
	testing.expect(test, missing.completed && missing.seq == 0)
}

@(test)
test_prompt_delivery_rolls_back_on_later_failure :: proc(test: ^testing.T) {
	directory := _temp_directory(test)
	defer _remove_directory(directory)
	writer := _open_journal(test, directory)
	defer _close_journal(test, writer)
	reader := _open_journal(test, directory)
	defer _close_journal(test, reader)
	session := _create_session(test, writer, {workspace = "/tmp/project", role = .Main})
	_commit_ok(test, writer)
	id, push_error := queue_push(writer, session, .Follow_Up, "prompt", nil)
	_expect_ok(test, push_error)
	result: Queue_Delivery
	queue_deliver(writer, session, id, nil, &result)
	append_record(writer, {kind = .Run_Started}, Run_Started{pid = 0})
	_, commit_error := commit(writer)
	testing.expect(test, commit_error != nil)
	testing.expect(test, !result.completed)
	entries, list_error := queue_list(reader, session, context.allocator)
	_expect_ok(test, list_error)
	defer queue_entries_destroy(entries, context.allocator)
	testing.expect_value(test, len(entries), 1)
	records := _records_of_session(test, reader, session)
	defer records_destroy(records, context.allocator)
	testing.expect_value(test, _record_seq_of_kind(records, .User_Input), Journal_Seq(0))
}

@(test)
test_prompt_hold_and_delivery :: proc(test: ^testing.T) {
	directory := _temp_directory(test)
	defer _remove_directory(directory)
	owner := _open_journal(test, directory)
	defer _close_journal(test, owner)
	session := _create_session(test, owner, {workspace = "/tmp/project", role = .Main})
	_commit_ok(test, owner)
	id, push_error := queue_push(owner, session, .Steering, "initial", {"file"})
	_expect_ok(test, push_error)
	second, second_error := queue_push(owner, session, .Follow_Up, "next", nil)
	_expect_ok(test, second_error)
	text, found, hold_error := queue_hold(owner, session, id, context.allocator)
	_expect_ok(test, hold_error)
	defer delete(text)
	testing.expect(test, found)
	testing.expect_value(test, text, "initial")
	again, held_again, again_error := queue_hold(owner, session, id, context.allocator)
	_expect_ok(test, again_error)
	delete(again)
	testing.expect(test, !held_again)
	entries, list_error := queue_list(owner, session, context.allocator)
	_expect_ok(test, list_error)
	if testing.expect_value(test, len(entries), 2) {
		testing.expect(test, entries[0].held)
		testing.expect_value(test, entries[0].id, id)
		testing.expect_value(test, entries[1].id, second)
	}
	queue_entries_destroy(entries, context.allocator)
	result: Queue_Delivery
	queue_deliver(owner, session, id, nil, &result)
	_commit_ok(test, owner)
	testing.expect(test, result.completed && result.seq == 0)
	released, release_error := queue_release(owner, session, id, "edited")
	_expect_ok(test, release_error)
	testing.expect(test, released)
	text2, held, hold2_error := queue_hold(owner, session, id, context.allocator)
	_expect_ok(test, hold2_error)
	defer delete(text2)
	testing.expect(test, held)
	testing.expect_value(test, text2, "edited")
	unheld, unhold_error := queue_unhold(owner, session, id)
	_expect_ok(test, unhold_error)
	testing.expect(test, unheld)
	queue_deliver(owner, session, id, nil, &result)
	_commit_ok(test, owner)
	testing.expect(test, result.completed && result.seq != 0)
	_, missing, missing_error := queue_hold(owner, session, id, context.allocator)
	_expect_ok(test, missing_error)
	testing.expect(test, !missing)
	removed, remove_error := queue_release(owner, session, second, "")
	_expect_ok(test, remove_error)
	testing.expect(test, removed)
	removed, remove_error = queue_release(owner, session, second, "")
	_expect_ok(test, remove_error)
	testing.expect(test, !removed)
}

@(test)
test_prompt_queue_wakes_the_session :: proc(test: ^testing.T) {
	directory := _temp_directory(test)
	defer _remove_directory(directory)
	owner := _open_journal(test, directory)
	defer _close_journal(test, owner)
	follower := _open_journal(test, directory)
	defer _close_journal(test, follower)
	session := _create_session(test, owner, {workspace = "/tmp/project", role = .Main})
	_commit_ok(test, owner)
	_expect_ok(test, follow(follower, session))
	_expect_ok(test, os.fchange_times(owner.lock_file, time.Time{}, time.Time{}))
	id, push_error := queue_push(follower, session, .Steering, "text", nil)
	_expect_ok(test, push_error)
	modified, stat_error := os.modification_time(owner.lock_file)
	_expect_ok(test, stat_error)
	testing.expect(test, modified != (time.Time{}))
	_expect_ok(test, os.fchange_times(owner.lock_file, time.Time{}, time.Time{}))
	text, found, hold_error := queue_hold(follower, session, id, context.allocator)
	_expect_ok(test, hold_error)
	delete(text)
	testing.expect(test, found)
	modified, stat_error = os.modification_time(owner.lock_file)
	_expect_ok(test, stat_error)
	testing.expect(test, modified != (time.Time{}))
	_expect_ok(test, os.fchange_times(owner.lock_file, time.Time{}, time.Time{}))
	released, release_error := queue_release(follower, session, id, "updated")
	_expect_ok(test, release_error)
	testing.expect(test, released)
	modified, stat_error = os.modification_time(owner.lock_file)
	_expect_ok(test, stat_error)
	testing.expect(test, modified != (time.Time{}))
	_expect_ok(test, os.fchange_times(owner.lock_file, time.Time{}, time.Time{}))
	edited, edit_error := queue_edit(follower, session, id, "edit")
	_expect_ok(test, edit_error)
	testing.expect(test, edited)
	modified, stat_error = os.modification_time(owner.lock_file)
	_expect_ok(test, stat_error)
	testing.expect(test, modified != (time.Time{}))
	text, found, hold_error = queue_hold(follower, session, id, context.allocator)
	_expect_ok(test, hold_error)
	delete(text)
	testing.expect(test, found)
	_expect_ok(test, os.fchange_times(owner.lock_file, time.Time{}, time.Time{}))
	unheld, unhold_error := queue_unhold(follower, session, id)
	_expect_ok(test, unhold_error)
	testing.expect(test, unheld)
	modified, stat_error = os.modification_time(owner.lock_file)
	_expect_ok(test, stat_error)
	testing.expect(test, modified != (time.Time{}))
	_expect_ok(test, os.fchange_times(owner.lock_file, time.Time{}, time.Time{}))
	removed, remove_error := queue_remove(follower, session, id)
	_expect_ok(test, remove_error)
	testing.expect(test, removed)
	modified, stat_error = os.modification_time(owner.lock_file)
	_expect_ok(test, stat_error)
	testing.expect(test, modified != (time.Time{}))
	_expect_ok(test, release(follower))
	_expect_ok(test, os.fchange_times(owner.lock_file, time.Time{}, time.Time{}))
	_, push_error = queue_push(follower, session, .Follow_Up, "unfollowed", nil)
	_expect_ok(test, push_error)
	modified, stat_error = os.modification_time(owner.lock_file)
	_expect_ok(test, stat_error)
	testing.expect(test, modified != (time.Time{}))
}

@(test)
test_earlier_held_prompt_blocks_only_its_kind :: proc(test: ^testing.T) {
	directory := _temp_directory(test)
	defer _remove_directory(directory)
	owner := _open_journal(test, directory)
	defer _close_journal(test, owner)
	follower := _open_journal(test, directory)
	defer _close_journal(test, follower)
	session := _create_session(test, owner, {workspace = "/tmp/project", role = .Main})
	_commit_ok(test, owner)
	earlier, earlier_error := queue_push(follower, session, .Steering, "earlier", nil)
	_expect_ok(test, earlier_error)
	later, later_error := queue_push(follower, session, .Steering, "later", nil)
	_expect_ok(test, later_error)
	other, other_error := queue_push(follower, session, .Follow_Up, "other kind", nil)
	_expect_ok(test, other_error)
	entries, list_error := queue_list(owner, session, context.allocator)
	_expect_ok(test, list_error)
	testing.expect_value(test, len(entries), 3)
	queue_entries_destroy(entries, context.allocator)
	text, held, hold_error := queue_hold(follower, session, earlier, context.allocator)
	_expect_ok(test, hold_error)
	delete(text)
	testing.expect(test, held)
	blocked: Queue_Delivery
	queue_deliver(owner, session, later, nil, &blocked)
	_commit_ok(test, owner)
	testing.expect(test, blocked.completed && blocked.seq == 0)
	entries, list_error = queue_list(owner, session, context.allocator)
	_expect_ok(test, list_error)
	if testing.expect_value(test, len(entries), 3) {
		testing.expect_value(test, entries[0].id, earlier)
		testing.expect(test, entries[0].held)
		testing.expect_value(test, entries[1].id, later)
	}
	queue_entries_destroy(entries, context.allocator)
	records := _records_of_session(test, owner, session)
	testing.expect_value(test, _record_seq_of_kind(records, .User_Input), Journal_Seq(0))
	records_destroy(records, context.allocator)
	independent: Queue_Delivery
	queue_deliver(owner, session, other, nil, &independent)
	_commit_ok(test, owner)
	testing.expect(test, independent.completed && independent.seq != 0)
	unheld, unhold_error := queue_unhold(follower, session, earlier)
	_expect_ok(test, unhold_error)
	testing.expect(test, unheld)
	queue_deliver(owner, session, later, nil, &blocked)
	_commit_ok(test, owner)
	testing.expect(test, blocked.completed && blocked.seq != 0)
}
